<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Daily-briefing trigger. Fires daily at 03:03 local time so atlas
  composes the brief while you sleep.

  Template substitution by install.sh:
    {{USER}}    → unix username
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.{{USER}}.atlas.daily-brief</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/{{USER}}/atlas/bin/daily-brief.sh</string>
  </array>

  <!-- Fires at 03:03 local. atlas runs the brief while you sleep so the
       message is waiting when you reach for your phone in the morning.
       Edit the Hour/Minute below if 3am isn't your shape. Off-:00 to
       avoid the cron-thundering-herd. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>3</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/{{USER}}/atlas/logs/daily-brief.launchd.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/{{USER}}/atlas/logs/daily-brief.launchd.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/{{USER}}</string>
  </dict>
</dict>
</plist>
